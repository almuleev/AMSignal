#include <winver.h>
#ifndef AM_VERSION_STRING
#define AM_VERSION_STRING "dev"
#endif
#ifndef AM_VERSION_NUMBERS
#define AM_VERSION_NUMBERS 0,0,0,0
#endif
#ifndef AM_ORIGINAL_FILENAME
#define AM_ORIGINAL_FILENAME "AMSignal.exe"
#endif
1 VERSIONINFO
 FILEVERSION AM_VERSION_NUMBERS
 PRODUCTVERSION AM_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "AMSignal contributors"
#ifdef AM_CLI
   VALUE "FileDescription", "AMSignal command-line signal analysis"
#else
   VALUE "FileDescription", "AMSignal desktop signal analysis"
#endif
   VALUE "FileVersion", AM_VERSION_STRING
   VALUE "ProductName", "AMSignal"
   VALUE "ProductVersion", AM_VERSION_STRING
   VALUE "OriginalFilename", AM_ORIGINAL_FILENAME
   VALUE "LegalCopyright", "AMSignal contributors; GNU GPLv3"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
